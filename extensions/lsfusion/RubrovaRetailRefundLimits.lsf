MODULE RubrovaRetailRefundLimits;
REQUIRE CreditNote, SessionPayment, IncomingPaymentDebt, OutgoingPaymentDebt;

// No requerir MyCompany: el diálogo POS nativo depende de este módulo y eso crearía un ciclo.

NAMESPACE Invoicing;

// Importe total del egreso nativo, normalizado por el ledger de deuda a la moneda funcional.
// En el POS nativo, PosDashboardReturnPayment asigna y aplica el mismo importe a la nota.
rubrovaOutgoingLedgerAmount (OutgoingPayment p) = amount[Debt](p);

NAMESPACE Retail;


// Importe efectivamente aplicado a la factura por cobros que siguen activos.
// Se usa paid(IncomingPayment, Invoice), no amount(IncomingPayment), porque un
// mismo cobro puede aplicarse parcialmente a más de una factura.
rubrovaOriginalPaidByMethod (Invoicing.Invoice originalInvoice, PaymentMethod pm) =
    GROUP SUM Invoicing.paid(Invoicing.IncomingPayment p, originalInvoice)
        IF paymentMethod(p, originalInvoice) = pm
        AND Invoicing.active(p);

rubrovaOriginalInvoiceForReturn (Invoicing.Bill currentBill) =
    GROUP MAX Invoicing.Invoice originalInvoice
        IF Invoicing.in(originalInvoice, currentBill);

rubrovaOriginalPaidForReturn 'Cobrado originalmente' (Invoicing.Bill currentBill, PaymentMethod pm) =
    rubrovaOriginalPaidByMethod(rubrovaOriginalInvoiceForReturn(currentBill), pm);

// Total de egresos todavía activos de todas las notas de crédito enlazadas
// a la factura original. Cancelar la nota no cancela automáticamente su pago;
// sólo deja de consumir cupo cuando el egreso nativo también está cancelado.
rubrovaRefundedByMethod (Invoicing.Invoice originalInvoice, PaymentMethod pm) =
    GROUP SUM Invoicing.rubrovaOutgoingLedgerAmount(Invoicing.OutgoingPayment p)
        IF Invoicing.in(originalInvoice, Invoicing.Bill previousBill)
        AND paymentMethod(previousBill, p) = pm
        AND Invoicing.active(p);

// Egresos activos de notas anteriores de la misma factura. Se excluye la nota
// actual para que el formulario pueda mostrar su cupo disponible mientras se edita.
rubrovaRefundedBefore (Invoicing.Bill currentBill, PaymentMethod pm) =
    GROUP SUM Invoicing.rubrovaOutgoingLedgerAmount(Invoicing.OutgoingPayment p)
        IF Invoicing.in(Invoicing.Invoice originalInvoice, currentBill)
        AND Invoicing.in(originalInvoice, Invoicing.Bill previousBill)
        AND previousBill != currentBill
        AND paymentMethod(previousBill, p) = pm
        AND Invoicing.active(p);

rubrovaRefundRemaining 'Saldo reintegrable' (Invoicing.Bill currentBill, PaymentMethod pm) =
    max((OVERRIDE rubrovaOriginalPaidForReturn(currentBill, pm), 0.0) (-)
        (OVERRIDE rubrovaRefundedBefore(currentBill, pm), 0.0), 0.0);

// Regla global: no se puede confirmar un conjunto de egresos activos que supere
// lo efectivamente cobrado en la factura original por ese mismo método.
CONSTRAINT SET(rubrovaRefundedByMethod(Invoicing.Invoice originalInvoice, PaymentMethod pm) >
    (OVERRIDE rubrovaOriginalPaidByMethod(originalInvoice, pm), 0.0))
    AND Invoicing.type(originalInvoice) = Invoicing.invoiceType('retail')
    MESSAGE 'El total reintegrado por medio de pago supera el importe cobrado originalmente';
