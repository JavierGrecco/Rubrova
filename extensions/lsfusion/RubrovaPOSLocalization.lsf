MODULE RubrovaPOSLocalization;
REQUIRE MyCompany;

NAMESPACE Retail;

// Rubrova-owned captions for the first operational POS flow.
// The upstream modules remain untouched; all strings use ResourceBundle IDs.
DESIGN posDashboard '{rubrova.pos.title}' {
    posHeader {
        PROPERTY(name(p)) { caption = '{rubrova.pos.cash_register}'; }
        PROPERTY(cashBalance(p)) { caption = '{rubrova.pos.cash_balance}'; }
    }
    sessionHeader {
        PROPERTY(number(s)) { caption = '{rubrova.pos.session_number}'; }
        PROPERTY(openSession(p)) { caption = '{rubrova.pos.open_session}'; }
        PROPERTY(openingDateTime(s)) { caption = '{rubrova.pos.opened}'; }
        PROPERTY(close(s)) { caption = '{rubrova.pos.close_session}'; }
    }
    invoiceHeader {
        PROPERTY(available(i, it)) { caption = '{rubrova.pos.available_short}'; charWidth = 8; }
    }
    invoice {
        PROPERTY(nameCustomer(i)) { caption = '{rubrova.pos.customer}'; }
        PROPERTY(phoneCustomer(i)) { caption = '{rubrova.pos.phone}'; }
        PROPERTY(emailCustomer(i)) { caption = '{rubrova.pos.email}'; }
    }
    GRID(l) {
        PROPERTY(index(l)) { caption = '{rubrova.pos.line_short}'; charWidth = 3; }
        PROPERTY(nameItem(l)) { caption = '{rubrova.pos.item}'; charWidth = 27; }
        PROPERTY(quantity(l)) { caption = '{rubrova.pos.quantity_short}'; charWidth = 7; }
        PROPERTY(price(l)) { caption = '{rubrova.pos.price}'; charWidth = 8; }
        PROPERTY(nameSalesDiscount(l)) { caption = '{rubrova.pos.discount_short}'; charWidth = 7; }
        PROPERTY(discount(l)) { caption = '{rubrova.pos.discount_percent_short}'; charWidth = 7; }
        PROPERTY(discountPrice(l)) { caption = '{rubrova.pos.discount_price_short}'; charWidth = 10; }
    }
    bill {
        PROPERTY(nameVendor(b)) { caption = '{rubrova.pos.return_customer}'; }
    }
    billInfo {
        PROPERTY(amount(b)) { caption = '{rubrova.pos.return_amount}'; }
    }
    total {
        PROPERTY(fullAmount(i)) { caption = '{rubrova.pos.subtotal}'; }
        PROPERTY(discountAmount(i)) { caption = '{rubrova.pos.discount_total}'; }
        PROPERTY(amount(i)) { caption = '{rubrova.pos.to_pay}'; }
    }
    sessionDetails {
        BOX(si) { caption = '{rubrova.pos.cash_receipts}'; }
        BOX(sb) { caption = '{rubrova.pos.refunds}'; }
        BOX(ip) { caption = '{rubrova.pos.cash_deposits}'; }
        BOX(op) { caption = '{rubrova.pos.cash_withdrawals}'; }
    }
    tabPane {
        search { caption = '{rubrova.pos.search}'; }
        touch { caption = '{rubrova.pos.touch}'; }
    }
    actions {
        PROPERTY(newReceipt(s)) { caption = '{rubrova.pos.new_receipt}'; }
        PROPERTY(posPayment(s, i)) { caption = '{rubrova.pos.payment}'; }
        PROPERTY(return(s, si)) { caption = '{rubrova.pos.return}'; }
    }
}


    // Captions puntuales de la búsqueda y la lista de pedidos del POS.
    DESIGN posDashboard {
        tabPane {
            search {
                PROPERTY(filterPrice()) { caption = '{rubrova.pos.search_price}'; }
                GRID(it) {
                    PROPERTY(name(it)) { charWidth = 26; }
                    PROPERTY(idBarCode(it)) { caption = '{rubrova.pos.barcode}'; charWidth = 14; }
                    PROPERTY(id(it)) { caption = '{rubrova.pos.code}'; charWidth = 8; }
                    PROPERTY(reference(it)) { caption = '{rubrova.pos.reference}'; charWidth = 8; }
                    PROPERTY(quantity(i, it)) { caption = '{rubrova.pos.quantity_short}'; charWidth = 7; }
                    PROPERTY(overListPrice(i, it)) { caption = '{rubrova.pos.price}'; charWidth = 8; }
                }
            }
            BOX(o) { caption = '{rubrova.pos.by_order}'; }
        }
    }

DESIGN posPayment '{rubrova.pos.payment_title}' {
    PROPERTY(nameCustomer(i)) { caption = '{rubrova.pos.customer}'; }
    PROPERTY(amount(i)) { caption = '{rubrova.pos.amount_due}'; }
    PROPERTY(change) { caption = '{rubrova.pos.change}'; }
}

DESIGN posPaymentReturn '{rubrova.pos.return_payment_title}' {
    PROPERTY(nameVendor(b)) { caption = '{rubrova.pos.customer}'; }
    PROPERTY(amount(b)) { caption = '{rubrova.pos.return_amount}'; }
    PROPERTY(invoicePaid(b, pm)) { caption = '{rubrova.pos.previous_payment}'; }
    PROPERTY(amount(pm)) { caption = '{rubrova.pos.refund_by_method}'; }
    PROPERTY(overFormOk) { caption = '{rubrova.pos.confirm_return}'; }
}

DESIGN inputMoney '{rubrova.pos.cash_adjustment}' {
    PROPERTY(keyboardDecimalInput()) { caption = '{rubrova.pos.amount}'; }
}

DESIGN paymentMethod '{rubrova.payment.method_title}' {
    PROPERTY(name(pm)) { caption = '{rubrova.payment.method_name}'; }
    PROPERTY(id(pm)) { caption = '{rubrova.payment.code}'; }
    PROPERTY(isCash(pm)) { caption = '{rubrova.payment.is_cash}'; }
    PROPERTY(nameIncomingPaymentType(pm)) { caption = '{rubrova.payment.incoming_type}'; }
    PROPERTY(nameOutgoingPaymentType(pm)) { caption = '{rubrova.payment.outgoing_type}'; }
}

DESIGN options {
    commons {
        PROPERTY(nameDepositPaymentType()) { caption = '{rubrova.cash.deposit_type}'; }
        PROPERTY(nameWithdrawPaymentType()) { caption = '{rubrova.cash.withdrawal_type}'; }
    }
}

// Defaults for the private Rubrova installation: keep retail prices and receivables
// in the organization currency, and show payment methods in Spanish.
loadDefaultData () + {
    IF defaultCurrency() THEN {
        Invoicing.currency(Invoicing.invoiceType('retail')) <- defaultCurrency();
        Sales.currency(Sales.priceType('retail')) <- defaultCurrency();
    }

    IF cashPaymentMethod() THEN
        name(cashPaymentMethod()) <- 'Efectivo';
    IF paymentMethod('card') THEN
        name(paymentMethod('card')) <- 'Tarjeta';

    // La expresión del FOR filtra por el ID estable: sólo se modifica el cliente genérico.
    FOR MasterData.id(MasterData.Individual i) = 'unknown' DO {
        MasterData.lastName(i) <- 'Consumidor final';
    }
}
