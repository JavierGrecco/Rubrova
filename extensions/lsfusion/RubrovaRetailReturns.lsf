MODULE RubrovaRetailReturns;
REQUIRE MyCompany, CreditNote;

NAMESPACE Invoicing;

// Cantidad devuelta antes del documento que se está creando.
// Se excluye el Bill actual para no contar dos veces sus líneas recién copiadas.
rubrovaPreviouslyReturnedQuantity (Bill currentBill, InvoiceLine originalLine) =
    OVERRIDE (GROUP SUM quantity(BillLine previousLine)
        IF invoiceLine(previousLine) = originalLine
        AND bill(previousLine) != currentBill
        AND active(bill(previousLine))), 0.0;

// Saldo de la línea original después de las devoluciones ya confirmadas.
rubrovaRemainingReturnQuantity (Bill currentBill, BillLine currentLine) =
    max(quantity(invoiceLine(currentLine)) (-)
        rubrovaPreviouslyReturnedQuantity(currentBill, invoiceLine(currentLine)), 0.0);

// CreditNote.create es una acción concreta de MyCompany, no un punto ACTION+.
// El módulo CreditNote expone fill(BillLine, InvoiceLine) como extensión abstracta.
// Ajustamos la línea recién copiada desde ese contrato, antes de finalizar la nota.
fill (BillLine currentLine, InvoiceLine originalLine) + {
    IF type(invoice(originalLine)) = invoiceType('retail') THEN {
        IF rubrovaRemainingReturnQuantity(bill(currentLine), currentLine) > 0.0 THEN
            quantity(currentLine) <- rubrovaRemainingReturnQuantity(bill(currentLine), currentLine);
        ELSE
            DELETE currentLine;
    }
}

NAMESPACE Retail;

// Total de egresos todavía activos de todas las notas de crédito enlazadas
// a la factura original. Cancelar la nota no cancela automáticamente su pago;
// sólo deja de consumir cupo cuando el egreso nativo también está cancelado.
rubrovaRefundedByMethod (Invoicing.Invoice originalInvoice, PaymentMethod pm) =
    GROUP SUM Invoicing.paid(Invoicing.Bill previousBill, Invoicing.OutgoingPayment p)
        IF Invoicing.in(originalInvoice, previousBill)
        AND paymentMethod(previousBill, p) = pm
        AND Invoicing.active(p);

// Egresos activos de notas anteriores de la misma factura. Se excluye la nota
// actual para que el formulario pueda mostrar su cupo disponible mientras se edita.
rubrovaRefundedBefore (Invoicing.Bill currentBill, PaymentMethod pm) =
    GROUP SUM Invoicing.paid(Invoicing.Bill previousBill, Invoicing.OutgoingPayment p)
        IF Invoicing.in(Invoicing.Invoice originalInvoice, currentBill)
        AND Invoicing.in(originalInvoice, previousBill)
        AND previousBill != currentBill
        AND paymentMethod(previousBill, p) = pm
        AND Invoicing.active(p);

rubrovaRefundRemaining 'Remaining refund' (Invoicing.Bill currentBill, PaymentMethod pm) =
    max((OVERRIDE invoicePaid(currentBill, pm), 0.0) (-)
        (OVERRIDE rubrovaRefundedBefore(currentBill, pm), 0.0), 0.0);

// Regla global: no se puede confirmar un conjunto de egresos activos que supere
// lo efectivamente cobrado en la factura original por ese mismo método.
CONSTRAINT SET(rubrovaRefundedByMethod(Invoicing.Invoice originalInvoice, PaymentMethod pm) >
    (OVERRIDE paid(originalInvoice, pm), 0.0))
    AND Invoicing.type(originalInvoice) = Invoicing.invoiceType('retail')
    MESSAGE 'El total reintegrado por medio de pago supera el importe cobrado originalmente';
