MODULE RubrovaIntegrationResilience;
REQUIRE MyCompany;

NAMESPACE Rubrova;

// Incidencias duraderas de adaptadores externos.
// No almacenar tokens, cookies, certificados, payloads sensibles ni encabezados de autorización.
CLASS IntegrationIncident 'Incidencia de integración';
TABLE rubrovaIntegrationIncident (IntegrationIncident);

provider 'Proveedor' = DATA ISTRING[80] (IntegrationIncident);
operation 'Operación' = DATA ISTRING[120] (IntegrationIncident);
correlationId 'Correlación' = DATA STRING[100] (IntegrationIncident);
category 'Categoría' = DATA STRING[40] (IntegrationIncident);
occurredAt 'Fecha' = DATA DATETIME (IntegrationIncident);
httpStatus 'Estado HTTP' = DATA INTEGER (IntegrationIncident);
attemptCount 'Intentos' = DATA INTEGER (IntegrationIncident);
safeToRetry 'Reintentable' = DATA BOOLEAN (IntegrationIncident);
localReference 'Referencia local' = DATA STRING[100] (IntegrationIncident);
remoteReference 'Referencia externa' = DATA STRING[100] (IntegrationIncident);
userMessage 'Mensaje para el operador' = DATA ISTRING[300] (IntegrationIncident);
technicalDetail 'Detalle técnico saneado' = DATA TEXT (IntegrationIncident);
resolved 'Resuelta' = DATA BOOLEAN (IntegrationIncident);
resolutionNote 'Resolución' = DATA ISTRING[300] (IntegrationIncident);
resolvedAt 'Fecha de resolución' = DATA DATETIME (IntegrationIncident);

// Todo adaptador debe llamar este helper inmediatamente antes de cada EXTERNAL HTTP.
// El límite máximo impide que una pantalla o tarea quede esperando de forma indefinida.
rubrovaSetIntegrationTimeout 'Establecer tiempo máximo de integración' (LONG timeoutMilliseconds) {
    IF timeoutMilliseconds < 1 OR timeoutMilliseconds > 30000 THEN
        throwException('El timeout de integración debe estar entre 1 y 30000 milisegundos.')
    ELSE
        timeoutHttp() <- timeoutMilliseconds;
}

// Registrar la incidencia en una sesión independiente para que no dependa
// de la transacción funcional que pudo fallar.
rubrovaRecordIntegrationIncident 'Registrar incidencia Rubrova'
    (STRING providerName, STRING operationName, STRING correlation,
     STRING errorCategory, INTEGER responseStatus, INTEGER attempts,
     BOOLEAN retryable, STRING localId, STRING remoteId,
     STRING operatorMessage, TEXT sanitizedTechnicalDetail) {
    TRY {
        NEWSESSION {
            NEW incident = IntegrationIncident {
                provider(incident) <- providerName;
                operation(incident) <- operationName;
                correlationId(incident) <- correlation;
                category(incident) <- errorCategory;
                occurredAt(incident) <- currentDateTime();
                httpStatus(incident) <- responseStatus;
                attemptCount(incident) <- attempts;
                safeToRetry(incident) <- retryable;
                localReference(incident) <- localId;
                remoteReference(incident) <- remoteId;
                userMessage(incident) <- operatorMessage;
                technicalDetail(incident) <- sanitizedTechnicalDetail;
                resolved(incident) <- FALSE;
            }
            APPLY;
        }
    } CATCH {
        // Último recurso: log local del servidor. El llamador no debe fallar
        // otra vez por no poder guardar la incidencia en la base principal.
        TRY {
            logToFile('rubrova-integration-emergency',
                providerName + ' / ' + operationName + ' / ' + errorCategory +
                ' / ' + correlation + ' / ' + sanitizedTechnicalDetail);
        } CATCH { }
    }
}

resolveIntegrationIncident 'Marcar incidencia resuelta' (IntegrationIncident incident) {
    INPUT note = ISTRING[300] DO {
        TRY {
            NEWSESSION {
                resolved(incident) <- TRUE;
                resolutionNote(incident) <- note();
                resolvedAt(incident) <- currentDateTime();
                APPLY;
            }
        } CATCH {
            MESSAGE 'No se pudo guardar la resolución. La incidencia continúa abierta.';
        }
    }
}

EXTEND FORM integrationData
    OBJECTS rubrovaIncidents = IntegrationIncident
    PROPERTIES(rubrovaIncidents) READONLY occurredAt, provider, operation, category,
        httpStatus, attemptCount, safeToRetry, localReference, remoteReference,
        userMessage, resolved, resolveIntegrationIncident
    FILTERS NOT resolved(rubrovaIncidents)
;

rubrovaHttpResponse = DATA LOCAL FILE();
rubrovaHttpSucceeded = DATA LOCAL BOOLEAN();
rubrovaHttpFailureCategory = DATA LOCAL STRING[40]();
rubrovaHttpFailureMessage = DATA LOCAL ISTRING[300]();

// GET se considera lectura idempotente. Este helper no reintenta por sí mismo:
// deja el fallo y su causa clasificados para que el worker o la pantalla decidan.
rubrovaHttpGet 'Consultar servicio externo (GET)' (STRING providerName, STRING operationName,
    STRING correlation, STRING url, LONG timeoutMilliseconds) {
    rubrovaHttpResponse() <- NULL;
    rubrovaHttpSucceeded() <- FALSE;
    rubrovaHttpFailureCategory() <- NULL;
    rubrovaHttpFailureMessage() <- NULL;

    IF timeoutMilliseconds < 1 OR timeoutMilliseconds > 30000 THEN {
        rubrovaHttpFailureCategory() <- 'CONFIGURATION_ERROR';
        rubrovaHttpFailureMessage() <- 'El tiempo de espera configurado no es válido.';
        rubrovaRecordIntegrationIncident(providerName, operationName, correlation,
            'CONFIGURATION_ERROR', NULL, 0, FALSE, NULL, NULL,
            rubrovaHttpFailureMessage(), 'Timeout fuera del rango permitido: 1 a 30000 ms.');
    } ELSE {
        TRY {
            rubrovaSetIntegrationTimeout(timeoutMilliseconds);
            EXTERNAL HTTP GET url TO rubrovaHttpResponse;

            IF failedHttp() THEN {
                rubrovaHttpFailureCategory() <- 'REMOTE_HTTP_ERROR';
                rubrovaHttpFailureMessage() <- 'El servicio externo respondió con un error HTTP.';
                rubrovaRecordIntegrationIncident(providerName, operationName, correlation,
                    'REMOTE_HTTP_ERROR', statusHttp(), 1, TRUE, NULL, NULL,
                    rubrovaHttpFailureMessage(), 'Respuesta HTTP no exitosa. Revisar código HTTP y contrato del proveedor.');
            } ELSE
                rubrovaHttpSucceeded() <- TRUE;
        } CATCH {
            rubrovaHttpFailureCategory() <- 'TIMEOUT_OR_NETWORK';
            rubrovaHttpFailureMessage() <- 'El servicio externo no respondió a tiempo o no se pudo establecer la conexión.';
            rubrovaRecordIntegrationIncident(providerName, operationName, correlation,
                'TIMEOUT_OR_NETWORK', statusHttp(), 1, TRUE, NULL, NULL,
                rubrovaHttpFailureMessage(), 'La solicitud GET terminó con una excepción de conexión o timeout. Detalle sensible omitido.');
        }
    }
}

