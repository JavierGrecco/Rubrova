// Smoke contract: the retail invoice type must enforce MyCompany's native return quantity guard.
rubrovaReturnSafetyApi () {
    EXPORT JSON FROM
        retailReturnQuantityGuardEnabled = Invoicing.checkReturnedQuantity(Invoicing.invoiceType('retail'));
} @@api;


// La captura por barcode usa setRealQuantity: 0 es una cantidad presente;
// NULL elimina la línea. Se comprueba también la agregación a AdjustmentLine.
rubrovaTestStocktakeBarcodeZeroApi () {
    Inventory.setRealQuantity(rubrovaCIStocktakeList(), rubrovaCITestProduct(), rubrovaCITestLocation(), 0);
    APPLY;
    IF canceled() THEN RETURN;
    EXPORT JSON FROM
        listLineCount = rubrovaCIStocktakeListLineCount(),
        adjustmentLineCount = rubrovaCIStocktakeAdjustmentLineCount(),
        zeroQuantityPreserved = rubrovaCIStocktakeListLineQuantity() = 0,
        adjustmentQuantityIsZero = rubrovaCIStocktakeAdjustmentLineQuantity() = 0,
        onHand = Inventory.onHand(rubrovaCITestLocation(), rubrovaCITestProduct());
} @@api;

rubrovaTestStocktakeBarcodeNullApi () {
    Inventory.setRealQuantity(rubrovaCIStocktakeList(), rubrovaCITestProduct(), rubrovaCITestLocation(), NULL);
    APPLY;
    IF canceled() THEN RETURN;
    EXPORT JSON FROM
        listLineCount = rubrovaCIStocktakeListLineCount(),
        adjustmentLineCount = rubrovaCIStocktakeAdjustmentLineCount(),
        adjustmentQuantityIsNull = NOT Inventory.realQuantity(rubrovaCIStocktakeAdjustmentLine()),
        onHand = Inventory.onHand(rubrovaCITestLocation(), rubrovaCITestProduct());
} @@api;

rubrovaTestStocktakeBarcodePositiveApi () {
    Inventory.setRealQuantity(rubrovaCIStocktakeList(), rubrovaCITestProduct(), rubrovaCITestLocation(), 2);
    APPLY;
    IF canceled() THEN RETURN;
    EXPORT JSON FROM
        listLineCount = rubrovaCIStocktakeListLineCount(),
        adjustmentLineCount = rubrovaCIStocktakeAdjustmentLineCount(),
        listQuantity = rubrovaCIStocktakeListLineQuantity(),
        adjustmentLineQuantity = rubrovaCIStocktakeAdjustmentLineQuantity(),
        onHand = Inventory.onHand(rubrovaCITestLocation(), rubrovaCITestProduct());
} @@api;

// Sonda de sólo lectura usada después del reinicio del servidor.
rubrovaTestStocktakeBarcodeStateApi () {
    EXPORT JSON FROM
        listLineCount = rubrovaCIStocktakeListLineCount(),
        adjustmentLineCount = rubrovaCIStocktakeAdjustmentLineCount(),
        listQuantity = rubrovaCIStocktakeListLineQuantity(),
        adjustmentLineQuantity = rubrovaCIStocktakeAdjustmentLineQuantity(),
