MODULE RubrovaCISalesFixture;
REQUIRE MyCompany, RubrovaPOSLocalization, RubrovaCIRetailFixture;
NAMESPACE Sales;

// El POS convierte el precio de lista usando la moneda de la organización.
loadDefaultData () + {
    currency(priceType('retail')) <- MasterData.defaultCurrency();
    priceType(Invoicing.invoiceType('retail')) <- priceType('retail');
    Invoicing.currency(Invoicing.invoiceType('retail')) <- MasterData.defaultCurrency();
}

// Identidades y stock sintéticos del depósito de CI.
rubrovaCITestLocation() = GROUP MAX Inventory.Location l
    IF Inventory.id(l) = 'rubrova-ci-location';
rubrovaCITestProduct() = GROUP MAX MasterData.Product p
    IF MasterData.id(p) = 'rubrova-ci-product';
rubrovaCITestStockSeeded = DATA BOOLEAN ();

// Conteo descartable para probar el contrato real de captura por barcode.
// Se mantiene en progreso y nunca se valida: no genera movimientos de inventario.
rubrovaCIStocktakeSeeded = DATA BOOLEAN ();
rubrovaCIStocktakeAdjustment = DATA Inventory.Adjustment ();
rubrovaCIStocktakeList = DATA Inventory.AdjustmentList ();

rubrovaCIStocktakeListLineCount() = (OVERRIDE
    (GROUP SUM 1 IF Inventory.AdjustmentListLine l
        AND Inventory.adjustmentList(l) = rubrovaCIStocktakeList()
        AND Inventory.product(l) = rubrovaCITestProduct()
        AND Inventory.location(l) = rubrovaCITestLocation()),
    0);

rubrovaCIStocktakeAdjustmentLineCount() = (OVERRIDE
    (GROUP SUM 1 IF Inventory.AdjustmentLine l
        AND Inventory.adjustment(l) = rubrovaCIStocktakeAdjustment()
        AND Inventory.product(l) = rubrovaCITestProduct()
        AND Inventory.location(l) = rubrovaCITestLocation()),
    0);

rubrovaCIStocktakeAdjustmentLine() = GROUP MAX Inventory.AdjustmentLine l
    IF Inventory.adjustment(l) = rubrovaCIStocktakeAdjustment()
        AND Inventory.product(l) = rubrovaCITestProduct()
        AND Inventory.location(l) = rubrovaCITestLocation();

rubrovaCIStocktakeListLine() = GROUP MAX Inventory.AdjustmentListLine l
    IF Inventory.adjustmentList(l) = rubrovaCIStocktakeList()
        AND Inventory.product(l) = rubrovaCITestProduct()
        AND Inventory.location(l) = rubrovaCITestLocation();

rubrovaCIStocktakeListLineQuantity() =
    Inventory.realQuantity(rubrovaCIStocktakeListLine());

rubrovaCIStocktakeAdjustmentLineQuantity() =
    Inventory.realQuantity(rubrovaCIStocktakeAdjustmentLine());

loadDefaultData () + {
    IF NOT rubrovaCITestLocation() THEN
        NEW locationCI = Inventory.Location {
            Inventory.id(locationCI) <- 'rubrova-ci-location';
            Inventory.name(locationCI) <- 'Depósito de prueba Rubrova';
            Inventory.company(locationCI) <- MasterData.defaultCompany();
        }

    Inventory.positiveOnHand(rubrovaCITestLocation()) <- TRUE;

    IF NOT rubrovaCITestStockSeeded() THEN {
        NEW adjustmentCI = Inventory.Adjustment {
            Inventory.type(adjustmentCI) <- Inventory.AdjustmentType.all;
            Inventory.location(adjustmentCI) <- rubrovaCITestLocation();
            Inventory.inProgress(adjustmentCI) <- TRUE;

            NEW adjustmentLineCI = Inventory.AdjustmentLine {
                Inventory.adjustment(adjustmentLineCI) <- adjustmentCI;
                Inventory.product(adjustmentLineCI) <- rubrovaCITestProduct();
                Inventory.location(adjustmentLineCI) <- rubrovaCITestLocation();
                Inventory.realQuantity(adjustmentLineCI) <- 10;
            }

            Inventory.done(adjustmentCI) <- TRUE;
        }
        rubrovaCITestStockSeeded() <- TRUE;
    }

    // MyCompany ya incorpora SessionShipment: ambas cajas de prueba usan el depósito CI.
    Retail.location(Retail.pos('rubrova-ci')) <- rubrovaCITestLocation();
    Retail.location(Retail.pos('rubrova-ci-refund')) <- rubrovaCITestLocation();

    IF NOT rubrovaCIStocktakeSeeded() THEN {
        NEW stocktakeCI = Inventory.Adjustment {
            Inventory.type(stocktakeCI) <- Inventory.AdjustmentType.all;
            Inventory.location(stocktakeCI) <- rubrovaCITestLocation();
            Inventory.note(stocktakeCI) <- 'rubrova-ci-stocktake-barcode';
            Inventory.useList(stocktakeCI) <- TRUE;
            Inventory.inProgress(stocktakeCI) <- TRUE;
            rubrovaCIStocktakeAdjustment() <- stocktakeCI;
        }
        NEW stocktakeListCI = Inventory.AdjustmentList {
            Inventory.adjustment(stocktakeListCI) <- rubrovaCIStocktakeAdjustment();
            rubrovaCIStocktakeList() <- stocktakeListCI;
        }
        rubrovaCIStocktakeSeeded() <- TRUE;
    }
}

rubrovaTestInventoryApi () {
    EXPORT JSON FROM
        incomingQuantity = Inventory.inQuantity(rubrovaCITestLocation(), rubrovaCITestProduct()),
        outgoingQuantity = Inventory.outQuantity(rubrovaCITestLocation(), rubrovaCITestProduct()),
        onHand = Inventory.onHand(rubrovaCITestLocation(), rubrovaCITestProduct());
} @@api;

rubrovaCISaleCount() = GROUP SUM 1
    IF Retail.session(Invoicing.Invoice i)
       AND Retail.pos(Retail.session(i)) = Retail.pos('rubrova-ci')
       AND Invoicing.countProductLines(i) > 0;

rubrovaCIPaidSaleCount() = GROUP SUM 1
    IF Retail.session(Invoicing.Invoice i)
       AND Retail.pos(Retail.session(i)) = Retail.pos('rubrova-ci')
       AND Invoicing.countProductLines(i) > 0 AND Invoicing.done(i);

rubrovaCISalesAmount() = GROUP SUM Invoicing.amount(Invoicing.Invoice i)
    IF Retail.session(i) AND Retail.pos(Retail.session(i)) = Retail.pos('rubrova-ci')
       AND Invoicing.countProductLines(i) > 0;

rubrovaCIPaidAmount() = GROUP SUM Invoicing.paid(Invoicing.Invoice i)
    IF Retail.session(i) AND Retail.pos(Retail.session(i)) = Retail.pos('rubrova-ci')
       AND Invoicing.countProductLines(i) > 0;

rubrovaCICashPaymentAmount() = GROUP SUM Retail.paid(Invoicing.Invoice i, Retail.cashPaymentMethod())
    IF Retail.session(i) AND Retail.pos(Retail.session(i)) = Retail.pos('rubrova-ci')
       AND Invoicing.countProductLines(i) > 0;

rubrovaCIIncomingPaymentCount() = GROUP SUM Invoicing.countIncomingPayment(Invoicing.Invoice i)
    IF Retail.session(i) AND Retail.pos(Retail.session(i)) = Retail.pos('rubrova-ci')
       AND Invoicing.countProductLines(i) > 0;

rubrovaCIMainOpenSessionCount() = OVERRIDE (GROUP SUM 1
    IF Retail.Session s
       AND Retail.pos(s) = Retail.pos('rubrova-ci')
       AND Retail.opened(s)), 0;

rubrovaCIRefundOpenSessionCount() = OVERRIDE (GROUP SUM 1
    IF Retail.Session s
       AND Retail.pos(s) = Retail.pos('rubrova-ci-refund')
       AND Retail.opened(s)), 0;

rubrovaTestPosSessionSelectionApi () {
    EXPORT JSON FROM
        mainOpenSessions = rubrovaCIMainOpenSessionCount(),
        refundOpenSessions = rubrovaCIRefundOpenSessionCount(),
        mainSessionNumber = Retail.number(Retail.openedSession(Retail.pos('rubrova-ci'))),
        refundSessionNumber = Retail.number(Retail.openedSession(Retail.pos('rubrova-ci-refund')));
} @@api;

rubrovaTestSalesReconciliationApi () {
    EXPORT JSON FROM
        salesCount = rubrovaCISaleCount(),
        paidSalesCount = rubrovaCIPaidSaleCount(),
        invoiceAmount = rubrovaCISalesAmount(),
        paidAmount = rubrovaCIPaidAmount(),
        cashPaidAmount = rubrovaCICashPaymentAmount(),
        incomingPaymentCount = rubrovaCIIncomingPaymentCount(),
        sessionCashPaid = Retail.paid(Retail.openedSession(Retail.pos('rubrova-ci')), Retail.cashPaymentMethod()),
        cashBalance = Retail.cashBalance(Retail.pos('rubrova-ci'));
} @@api;

rubrovaCITestSession() = GROUP MAX Retail.Session s
    IF Retail.pos(s) = Retail.pos('rubrova-ci');

rubrovaTestSessionCloseApi () {
    EXPORT JSON FROM
        sessionNumber = Retail.number(rubrovaCITestSession()),
        openingDateTime = Retail.openingDateTime(rubrovaCITestSession()),
        closingDateTime = Retail.closingDateTime(rubrovaCITestSession()),
        sessionStatus = CASE WHEN Retail.opened(rubrovaCITestSession()) THEN 'OPEN' ELSE 'CLOSED',
        salesCount = Retail.countInvoices(rubrovaCITestSession()),
        salesAmount = Retail.totalAmountInvoice(rubrovaCITestSession()),
        returnsCount = Retail.countBills(rubrovaCITestSession()),
        returnsAmount = Retail.totalAmountBill(rubrovaCITestSession()),
        netAmount = Retail.amount(rubrovaCITestSession()),
        cashPaid = Retail.paid(rubrovaCITestSession(), Retail.cashPaymentMethod()),
        cashBalance = Retail.cashBalance(Retail.pos('rubrova-ci'));
} @@api;



rubrovaCITestInvoice() = GROUP MAX Invoicing.Invoice i
    IF Retail.session(i) = rubrovaCITestSession()
       AND Invoicing.countProductLines(i) > 0
       AND Invoicing.done(i);

rubrovaCITestInvoiceLine() = GROUP MAX Invoicing.InvoiceLine il
    IF Invoicing.invoice(il) = rubrovaCITestInvoice()
       AND Invoicing.item(il) = rubrovaCITestProduct();

// MyCompany deja NULL cuando un conjunto de devoluciones está vacío.
// Normalizamos esos agregados a cero: sin esto, la condición inicial = 0 nunca se ejecuta.
rubrovaCIReturnCount() = OVERRIDE Retail.countBills(rubrovaCITestSession()), 0;
rubrovaCIReturnAmount() = OVERRIDE Retail.totalAmountBill(rubrovaCITestSession()), 0.0;
rubrovaCIReturnedQuantity() = OVERRIDE Invoicing.returned(rubrovaCITestInvoiceLine()), 0.0;

rubrovaCIReturnCashPaymentCount() = OVERRIDE (GROUP SUM 1
    IF Retail.session(Invoicing.Bill b) = rubrovaCITestSession()
       AND Retail.paymentMethod(b, Invoicing.OutgoingPayment p) = Retail.cashPaymentMethod()), 0;

rubrovaCIReturnCashPaymentAmount() = OVERRIDE (GROUP SUM Invoicing.rubrovaOutgoingLedgerAmount(Invoicing.OutgoingPayment p)
    IF Retail.session(Invoicing.Bill b) = rubrovaCITestSession()
       AND Retail.paymentMethod(b, p) = Retail.cashPaymentMethod()), 0.0;

rubrovaOverReturnRejected = DATA BOOLEAN ();
rubrovaOverReturnRejectedLocal = DATA LOCAL NESTED BOOLEAN ();

// Reproduce el mismo documento de crédito y reintegro que usa el POS.
// Un valor de cantidad 0 conserva el remanente calculado por RubrovaRetailReturns.
rubrovaCreateCIReturn (Invoicing.Bill b, Invoicing.Invoice i, NUMERIC[16,3] explicitQuantity) {
    Retail.session(b) <- Retail.session(i);
    Invoicing.create(b, i);
    // CreditNote.fill y los eventos de precio/impuestos son locales. El POS
    // interactivo los procesa antes de mostrar/conciliar amount(b); en CI
    // debemos forzar el mismo paso antes de crear el egreso no nulo.
    executeLocalEvents();

    IF explicitQuantity > 0.0 THEN
        FOR Invoicing.bill(Invoicing.BillLine bl) = b DO
            Invoicing.quantity(bl) <- explicitQuantity;

    // Cambiar quantity puede recalcular importes y tributos de la nota.
    executeLocalEvents();

    // Este fixture acepta sólo efectivo: crear directamente el egreso nativo
    // evita depender del buffer LOCAL de la pantalla de cobro POS.
    NEW p = Invoicing.OutgoingPayment {
        Invoicing.done(p) <- TRUE;
        Retail.paymentMethod(b, p) <- Retail.cashPaymentMethod();
        Invoicing.type(p) <- Retail.outgoingPaymentType(Retail.cashPaymentMethod());
        Invoicing.company(p) <- Retail.company(Retail.pos(Retail.session(b)));
        Invoicing.companyAccount(p) <- Retail.account(Retail.pos(Retail.session(b)), Retail.cashPaymentMethod());
        Invoicing.partner(p) <- Invoicing.vendor(b);
        Invoicing.amount(p) <- Invoicing.amount(b);
        Invoicing.paid(b, p) <- Invoicing.amount(b);
    }

    Invoicing.ready(b) <- TRUE;
}

rubrovaTestPartialReturnsApi () {
    // Primera devolución: se devuelven 0,4 unidades de una venta de 1 unidad.
    IF rubrovaCIReturnCount() = 0 AND rubrovaCITestInvoice() THEN
        NEWSESSION {
            NEW b = Invoicing.Bill {
                rubrovaCreateCIReturn(b, rubrovaCITestInvoice(), 0.4);
                APPLY;
                IF canceled() THEN RETURN;
            }
        }

    // Intento inválido: sólo quedan 0,6 unidades, por lo que 0,7 debe rechazarse.
    IF rubrovaCIReturnCount() = 1 AND rubrovaCITestInvoice() THEN {
        rubrovaOverReturnRejected() <- NULL;
        rubrovaOverReturnRejectedLocal() <- NULL;
        NEWSESSION {
            NEW b = Invoicing.Bill {
                Retail.session(b) <- Retail.session(rubrovaCITestInvoice());
                Invoicing.create(b, rubrovaCITestInvoice());
                FOR Invoicing.bill(Invoicing.BillLine bl) = b DO
                    Invoicing.quantity(bl) <- 0.7;
                Invoicing.ready(b) <- TRUE;
                APPLY;
                // El APPLY rechazado conserva cambios sólo en la sesión hija.
                // La marca LOCAL NESTED vuelve a la sesión exterior al cerrar NEWSESSION.
                IF canceled() THEN rubrovaOverReturnRejectedLocal() <- TRUE;
            }
        }
        IF rubrovaOverReturnRejectedLocal() THEN {
            // Persistir la evidencia en una transacción limpia, fuera del APPLY cancelado.
            rubrovaOverReturnRejected() <- TRUE;
            APPLY;
            IF canceled() THEN RETURN;
        }
    }

    // Segunda devolución válida: la cantidad por defecto debe ser el remanente 0,6.
    IF rubrovaCIReturnCount() = 1 AND rubrovaOverReturnRejected() AND rubrovaCITestInvoice() THEN
        NEWSESSION {
            NEW b = Invoicing.Bill {
                rubrovaCreateCIReturn(b, rubrovaCITestInvoice(), 0.0);
                APPLY;
                IF canceled() THEN RETURN;
            }
        }

    EXPORT JSON FROM
        sourceInvoiceFound = CASE WHEN rubrovaCITestInvoice() THEN 1 ELSE 0,
        sourceInvoiceLineFound = CASE WHEN rubrovaCITestInvoiceLine() THEN 1 ELSE 0,
        overReturnRejected = rubrovaOverReturnRejected(),
        returnBillCount = rubrovaCIReturnCount(),
        returnAmount = rubrovaCIReturnAmount(),
        returnedQuantity = rubrovaCIReturnedQuantity(),
        cashRefundPaymentCount = rubrovaCIReturnCashPaymentCount(),
        cashRefundPaymentAmount = rubrovaCIReturnCashPaymentAmount(),
        sessionCashNet = Retail.paid(rubrovaCITestSession(), Retail.cashPaymentMethod()),
        cashBalance = Retail.cashBalance(Retail.pos('rubrova-ci')),
        onHand = Inventory.onHand(rubrovaCITestLocation(), rubrovaCITestProduct());
} @@api;

rubrovaPartialReturnsReconciliationApi () {
    EXPORT JSON FROM
        overReturnRejected = rubrovaOverReturnRejected(),
        returnBillCount = rubrovaCIReturnCount(),
        returnAmount = rubrovaCIReturnAmount(),
        returnedQuantity = rubrovaCIReturnedQuantity(),
        cashRefundPaymentCount = rubrovaCIReturnCashPaymentCount(),
        cashRefundPaymentAmount = rubrovaCIReturnCashPaymentAmount(),
        sessionCashNet = Retail.paid(rubrovaCITestSession(), Retail.cashPaymentMethod()),
        cashBalance = Retail.cashBalance(Retail.pos('rubrova-ci')),
        onHand = Inventory.onHand(rubrovaCITestLocation(), rubrovaCITestProduct());
} @@api;


// Escenario aislado de reintegros mixtos. Usa otra caja/turno para no modificar
// la conciliación histórica del smoke principal.
rubrovaCIMixedSession() = GROUP MAX Retail.Session s
    IF Retail.pos(s) = Retail.pos('rubrova-ci-refund');

rubrovaCIMixedInvoice() = GROUP MAX Invoicing.Invoice i
    IF Retail.session(i) = rubrovaCIMixedSession()
       AND Invoicing.countProductLines(i) > 0;

rubrovaCIMixedInvoiceLine() = GROUP MAX Invoicing.InvoiceLine il
    IF Invoicing.invoice(il) = rubrovaCIMixedInvoice()
       AND Invoicing.item(il) = rubrovaCITestProduct();

rubrovaCIMixedActiveReturnCount() = OVERRIDE (GROUP SUM 1
    IF Retail.session(Invoicing.Bill b) = rubrovaCIMixedSession()
       AND Invoicing.active(b)), 0;

rubrovaCIMixedActiveReturnAmount() = OVERRIDE (GROUP SUM Invoicing.amount(Invoicing.Bill b)
    IF Retail.session(b) = rubrovaCIMixedSession()
       AND Invoicing.active(b)), 0.0;

rubrovaCIMixedReturnedQuantity() = OVERRIDE Invoicing.returned(rubrovaCIMixedInvoiceLine()), 0.0;

rubrovaCIMixedActivePaymentCount(PaymentMethod pm) = OVERRIDE (GROUP SUM 1
    IF Retail.session(Invoicing.Bill b) = rubrovaCIMixedSession()
       AND Retail.paymentMethod(b, Invoicing.OutgoingPayment p) = pm
       AND Invoicing.active(p)), 0;

rubrovaCIMixedActivePaymentAmount(PaymentMethod pm) = OVERRIDE (GROUP SUM Invoicing.rubrovaOutgoingLedgerAmount(Invoicing.OutgoingPayment p)
    IF Retail.session(Invoicing.Bill b) = rubrovaCIMixedSession()
       AND Retail.paymentMethod(b, p) = pm
       AND Invoicing.active(p)), 0.0;

rubrovaCIMixedFirstRefundBill = DATA Invoicing.Bill ();
rubrovaCIMixedOpeningCashPayment = DATA Invoicing.IncomingPayment ();
rubrovaCIMixedOpeningCardPayment = DATA Invoicing.IncomingPayment ();
rubrovaCIMixedOverLimitRejected = DATA BOOLEAN ();
rubrovaCIMixedOverLimitMessage = DATA STRING[1000] ();
rubrovaCIMixedOverLimitRejectedLocal = DATA LOCAL NESTED BOOLEAN ();
rubrovaCIMixedOverLimitMessageLocal = DATA LOCAL NESTED STRING[1000] ();
rubrovaCIMixedRaceAAccepted = DATA LOCAL NESTED BOOLEAN ();
rubrovaCIMixedRaceAMessage = DATA LOCAL NESTED STRING[1000] ();
rubrovaCIMixedRaceBAccepted = DATA LOCAL NESTED BOOLEAN ();
rubrovaCIMixedRaceBMessage = DATA LOCAL NESTED STRING[1000] ();
rubrovaCIMixedBillCancelOverLimitRejected = DATA BOOLEAN ();
rubrovaCIMixedBillCancelOverLimitMessage = DATA STRING[1000] ();
rubrovaCIMixedBillCancelRejectedLocal = DATA LOCAL NESTED BOOLEAN ();
rubrovaCIMixedBillCancelMessageLocal = DATA LOCAL NESTED STRING[1000] ();

// Fondos previos en las cuentas sintéticas. Separan el control de disponibilidad
// contable del límite por factura: la prueba no debe fallar por saldo negativo
// antes de que pueda ejecutarse el guard acumulativo por medio de pago.
rubrovaEnsureCIMixedOpeningBalances () {
    IF NOT rubrovaCIMixedOpeningCashPayment() THEN
        NEWSESSION {
            NEW openingCash = Invoicing.IncomingPayment {
                Invoicing.type(openingCash) <- Invoicing.incomingPaymentType('initial');
                Invoicing.company(openingCash) <- Retail.company(Retail.pos('rubrova-ci-refund'));
                Invoicing.companyAccount(openingCash) <- Retail.account(Retail.pos('rubrova-ci-refund'), Retail.cashPaymentMethod());
                Invoicing.amount(openingCash) <- 1000;
                Invoicing.note(openingCash) <- 'Saldo inicial sintético para prueba de reintegros';
                Invoicing.reference(openingCash) <- 'rubrova-ci-opening-cash';
                Invoicing.done(openingCash) <- TRUE;
                rubrovaCIMixedOpeningCashPayment() <- openingCash;
                APPLY SERIALIZABLE;
                IF canceled() THEN RETURN;
            }
        }

    IF NOT rubrovaCIMixedOpeningCardPayment() THEN
        NEWSESSION {
            NEW openingCard = Invoicing.IncomingPayment {
                Invoicing.type(openingCard) <- Invoicing.incomingPaymentType('initial');
                Invoicing.company(openingCard) <- Retail.company(Retail.pos('rubrova-ci-refund'));
                Invoicing.companyAccount(openingCard) <- Retail.account(Retail.pos('rubrova-ci-refund'), Retail.paymentMethod('card'));
                Invoicing.amount(openingCard) <- 1000;
                Invoicing.note(openingCard) <- 'Saldo inicial sintético para prueba de reintegros';
                Invoicing.reference(openingCard) <- 'rubrova-ci-opening-card';
                Invoicing.done(openingCard) <- TRUE;
                rubrovaCIMixedOpeningCardPayment() <- openingCard;
                APPLY SERIALIZABLE;
                IF canceled() THEN RETURN;
            }
        }
}

rubrovaEnsureCIMixedSale () {
    IF NOT rubrovaCIMixedSession() THEN
        NEWSESSION {
            NEW mixedSession = Retail.Session {
                Retail.pos(mixedSession) <- Retail.pos('rubrova-ci-refund');
                Retail.beforeOpen(mixedSession);
                APPLY SERIALIZABLE;
                IF NOT canceled() THEN
                    Retail.afterOpen(mixedSession);
            }
        }
    IF NOT rubrovaCIMixedSession() THEN RETURN;

    rubrovaEnsureCIMixedOpeningBalances();
    IF NOT rubrovaCIMixedOpeningCashPayment() OR NOT rubrovaCIMixedOpeningCardPayment() THEN RETURN;

    IF NOT rubrovaCIMixedInvoice() THEN
        NEWSESSION {
            NEW mixedInvoice = Invoicing.Invoice {
                Retail.session(mixedInvoice) <- rubrovaCIMixedSession();
                Invoicing.clone(mixedInvoice, rubrovaCITestInvoice());

                NEW cashIncoming = Invoicing.IncomingPayment {
                    Invoicing.done(cashIncoming) <- TRUE;
                    Retail.paymentMethod(cashIncoming, mixedInvoice) <- Retail.cashPaymentMethod();
                    Invoicing.type(cashIncoming) <- Retail.incomingPaymentType(Retail.cashPaymentMethod());
                    Invoicing.company(cashIncoming) <- Invoicing.company(mixedInvoice);
                    Invoicing.companyAccount(cashIncoming) <- Retail.account(Retail.pos(Retail.session(mixedInvoice)), Retail.cashPaymentMethod());
                    Invoicing.partner(cashIncoming) <- Invoicing.customer(mixedInvoice);
                    Invoicing.amount(cashIncoming) <- 500;
                    Invoicing.paid(cashIncoming, mixedInvoice) <- 500;
                }

                NEW cardIncoming = Invoicing.IncomingPayment {
                    Invoicing.done(cardIncoming) <- TRUE;
                    Retail.paymentMethod(cardIncoming, mixedInvoice) <- Retail.paymentMethod('card');
                    Invoicing.type(cardIncoming) <- Retail.incomingPaymentType(Retail.paymentMethod('card'));
                    Invoicing.company(cardIncoming) <- Invoicing.company(mixedInvoice);
                    Invoicing.companyAccount(cardIncoming) <- Retail.account(Retail.pos(Retail.session(mixedInvoice)), Retail.paymentMethod('card'));
                    Invoicing.partner(cardIncoming) <- Invoicing.customer(mixedInvoice);
                    Invoicing.amount(cardIncoming) <- 750;
                    Invoicing.paid(cardIncoming, mixedInvoice) <- 750;
                }

                Invoicing.ready(mixedInvoice) <- TRUE;
                APPLY SERIALIZABLE;
                IF canceled() THEN RETURN;
            }
        }
}

rubrovaCreateCIMixedReturn (Invoicing.Bill b, Invoicing.Invoice i,
                            NUMERIC[16,3] explicitQuantity,
                            NUMERIC[14,2] cashRefund,
                            NUMERIC[14,2] cardRefund) {
    Retail.session(b) <- Retail.session(i);
    Invoicing.create(b, i);
    executeLocalEvents();

    IF explicitQuantity > 0.0 THEN
        FOR Invoicing.bill(Invoicing.BillLine bl) = b DO
            Invoicing.quantity(bl) <- explicitQuantity;

    executeLocalEvents();

    IF cashRefund > 0.0 THEN
        NEW cashOutgoing = Invoicing.OutgoingPayment {
            Invoicing.done(cashOutgoing) <- TRUE;
            Retail.paymentMethod(b, cashOutgoing) <- Retail.cashPaymentMethod();
            Invoicing.type(cashOutgoing) <- Retail.outgoingPaymentType(Retail.cashPaymentMethod());
            Invoicing.company(cashOutgoing) <- Invoicing.company(b);
            Invoicing.companyAccount(cashOutgoing) <- Retail.account(Retail.pos(Retail.session(b)), Retail.cashPaymentMethod());
            Invoicing.partner(cashOutgoing) <- Invoicing.vendor(b);
            Invoicing.amount(cashOutgoing) <- cashRefund;
            Invoicing.paid(b, cashOutgoing) <- cashRefund;
        }

    IF cardRefund > 0.0 THEN
        NEW cardOutgoing = Invoicing.OutgoingPayment {
            Invoicing.done(cardOutgoing) <- TRUE;
            Retail.paymentMethod(b, cardOutgoing) <- Retail.paymentMethod('card');
            Invoicing.type(cardOutgoing) <- Retail.outgoingPaymentType(Retail.paymentMethod('card'));
            Invoicing.company(cardOutgoing) <- Invoicing.company(b);
            Invoicing.companyAccount(cardOutgoing) <- Retail.account(Retail.pos(Retail.session(b)), Retail.paymentMethod('card'));
            Invoicing.partner(cardOutgoing) <- Invoicing.vendor(b);
            Invoicing.amount(cardOutgoing) <- cardRefund;
            Invoicing.paid(b, cardOutgoing) <- cardRefund;
        }

    Invoicing.ready(b) <- TRUE;
}

rubrovaTestCumulativeRefundsApi () {
    rubrovaEnsureCIMixedSale();

    // Primera nota: ARS 200 efectivo + ARS 300 tarjeta sobre 0,4 unidades.
    IF NOT rubrovaCIMixedFirstRefundBill() AND rubrovaCIMixedInvoice() THEN {
        // DATA BOOLEAN persistente se limpia con NULL; FALSE no es un valor válido aquí.
        rubrovaCIMixedOverLimitRejected() <- NULL;
        rubrovaCIMixedOverLimitMessage() <- NULL;
        NEWSESSION {
            NEW b = Invoicing.Bill {
                rubrovaCreateCIMixedReturn(b, rubrovaCIMixedInvoice(), 0.4, 200, 300);
                rubrovaCIMixedFirstRefundBill() <- b;
                APPLY SERIALIZABLE;
                IF canceled() THEN RETURN;
            }
        }
    }

    // Segundo intento: 600 de tarjeta son menores que los 750 originales,
    // pero sumados a los 300 ya reintegrados deben ser rechazados (900 > 750).
    IF rubrovaCIMixedFirstRefundBill() AND NOT rubrovaCIMixedOverLimitRejected() THEN {
        rubrovaCIMixedOverLimitRejectedLocal() <- NULL;
        rubrovaCIMixedOverLimitMessageLocal() <- NULL;
        NEWSESSION {
            NEW b = Invoicing.Bill {
                rubrovaCreateCIMixedReturn(b, rubrovaCIMixedInvoice(), 0.6, 150, 600);
                APPLY SERIALIZABLE;
                IF canceled() THEN {
                    rubrovaCIMixedOverLimitRejectedLocal() <- TRUE;
                    rubrovaCIMixedOverLimitMessageLocal() <- applyMessage();
                }
            }
        }
        IF rubrovaCIMixedOverLimitRejectedLocal() THEN {
            rubrovaCIMixedOverLimitRejected() <- TRUE;
            rubrovaCIMixedOverLimitMessage() <- rubrovaCIMixedOverLimitMessageLocal();
            APPLY;
            IF canceled() THEN RETURN;
        }
    }

    EXPORT JSON FROM
        sourceInvoiceFound = CASE WHEN rubrovaCIMixedInvoice() THEN 1 ELSE 0,
        sourceInvoiceDone = Invoicing.done(rubrovaCIMixedInvoice()),
        originalCashPaid = Retail.paid(rubrovaCIMixedInvoice(), Retail.cashPaymentMethod()),
        originalCardPaid = Retail.paid(rubrovaCIMixedInvoice(), Retail.paymentMethod('card')),
        overLimitRejected = rubrovaCIMixedOverLimitRejected(),
        overLimitMessage = rubrovaCIMixedOverLimitMessage(),
        activeReturnCount = rubrovaCIMixedActiveReturnCount(),
        activeReturnAmount = rubrovaCIMixedActiveReturnAmount(),
        returnedQuantity = rubrovaCIMixedReturnedQuantity(),
        activeCashRefundCount = rubrovaCIMixedActivePaymentCount(Retail.cashPaymentMethod()),
        activeCashRefundAmount = rubrovaCIMixedActivePaymentAmount(Retail.cashPaymentMethod()),
        activeCardRefundCount = rubrovaCIMixedActivePaymentCount(Retail.paymentMethod('card')),
        activeCardRefundAmount = rubrovaCIMixedActivePaymentAmount(Retail.paymentMethod('card')),
        onHand = Inventory.onHand(rubrovaCITestLocation(), rubrovaCITestProduct()),
        cashAccountBalance = Invoicing.balance(Retail.account(Retail.pos('rubrova-ci-refund'), Retail.cashPaymentMethod())),
        cardAccountBalance = Invoicing.balance(Retail.account(Retail.pos('rubrova-ci-refund'), Retail.paymentMethod('card')));

} @@api;

rubrovaTestCumulativeRefundRaceAApi () {
    rubrovaCIMixedRaceAAccepted() <- NULL;
    rubrovaCIMixedRaceAMessage() <- NULL;
    NEWSESSION {
        NEW b = Invoicing.Bill {
            rubrovaCreateCIMixedReturn(b, rubrovaCIMixedInvoice(), 0.24, 0, 300);
            APPLY SERIALIZABLE;
            IF canceled() THEN
                rubrovaCIMixedRaceAMessage() <- applyMessage();
            ELSE
                rubrovaCIMixedRaceAAccepted() <- TRUE;
        }
    }
    EXPORT JSON FROM
        accepted = rubrovaCIMixedRaceAAccepted(),
        applyMessage = rubrovaCIMixedRaceAMessage();
} @@api;

rubrovaTestCumulativeRefundRaceBApi () {
    rubrovaCIMixedRaceBAccepted() <- NULL;
    rubrovaCIMixedRaceBMessage() <- NULL;
    NEWSESSION {
        NEW b = Invoicing.Bill {
            rubrovaCreateCIMixedReturn(b, rubrovaCIMixedInvoice(), 0.24, 0, 300);
            APPLY SERIALIZABLE;
            IF canceled() THEN
                rubrovaCIMixedRaceBMessage() <- applyMessage();
            ELSE
                rubrovaCIMixedRaceBAccepted() <- TRUE;
        }
    }
    EXPORT JSON FROM
        accepted = rubrovaCIMixedRaceBAccepted(),
        applyMessage = rubrovaCIMixedRaceBMessage();
} @@api;

rubrovaTestCumulativeRefundFinishApi () {
    IF rubrovaCIMixedReturnedQuantity() < 1.0 THEN
        NEWSESSION {
            NEW b = Invoicing.Bill {
                rubrovaCreateCIMixedReturn(b, rubrovaCIMixedInvoice(), 0.36, 300, 150);
                APPLY SERIALIZABLE;
                IF canceled() THEN RETURN;
            }
        }
    EXPORT JSON FROM
        activeReturnCount = rubrovaCIMixedActiveReturnCount(),
        activeReturnAmount = rubrovaCIMixedActiveReturnAmount(),
        returnedQuantity = rubrovaCIMixedReturnedQuantity(),
        activeCashRefundAmount = rubrovaCIMixedActivePaymentAmount(Retail.cashPaymentMethod()),
        activeCardRefundAmount = rubrovaCIMixedActivePaymentAmount(Retail.paymentMethod('card')),
        cashAccountBalance = Invoicing.balance(Retail.account(Retail.pos('rubrova-ci-refund'), Retail.cashPaymentMethod())),
        cardAccountBalance = Invoicing.balance(Retail.account(Retail.pos('rubrova-ci-refund'), Retail.paymentMethod('card')));

} @@api;

// Cancelar sólo la nota no debe liberar el cupo: los egresos nativos siguen activos.
// La prueba intenta reutilizar exactamente los importes de esa nota y debe rechazarlos.
rubrovaTestCumulativeRefundBillCancelApi () {
    IF Invoicing.active(rubrovaCIMixedFirstRefundBill()) THEN
        Invoicing.cancel(rubrovaCIMixedFirstRefundBill());

    rubrovaCIMixedBillCancelRejectedLocal() <- NULL;
    rubrovaCIMixedBillCancelMessageLocal() <- NULL;
    NEWSESSION {
        NEW b = Invoicing.Bill {
            rubrovaCreateCIMixedReturn(b, rubrovaCIMixedInvoice(), 0.4, 200, 300);
            APPLY SERIALIZABLE;
            IF canceled() THEN {
                rubrovaCIMixedBillCancelRejectedLocal() <- TRUE;
                rubrovaCIMixedBillCancelMessageLocal() <- applyMessage();
            }
        }
    }
    IF rubrovaCIMixedBillCancelRejectedLocal() THEN {
        rubrovaCIMixedBillCancelOverLimitRejected() <- TRUE;
        rubrovaCIMixedBillCancelOverLimitMessage() <- rubrovaCIMixedBillCancelMessageLocal();
        APPLY;
        IF canceled() THEN RETURN;
    }

    EXPORT JSON FROM
        originalBillActive = Invoicing.active(rubrovaCIMixedFirstRefundBill()),
        originalBillCanceled = Invoicing.canceled(rubrovaCIMixedFirstRefundBill()),
        originalBillReady = Invoicing.ready(rubrovaCIMixedFirstRefundBill()),
        originalBillActivityState = CASE WHEN Invoicing.active(rubrovaCIMixedFirstRefundBill()) THEN 'active' ELSE 'inactive',
        originalBillOutgoingActiveCount = (GROUP SUM 1
            IF Retail.paymentMethod(rubrovaCIMixedFirstRefundBill(), Invoicing.OutgoingPayment p)
               AND Invoicing.active(p)),
        overLimitRejected = rubrovaCIMixedBillCancelOverLimitRejected(),
        overLimitMessage = rubrovaCIMixedBillCancelOverLimitMessage(),
        activeCashRefundAmount = rubrovaCIMixedActivePaymentAmount(Retail.cashPaymentMethod()),
        activeCardRefundAmount = rubrovaCIMixedActivePaymentAmount(Retail.paymentMethod('card')),
        cashAccountBalance = Invoicing.balance(Retail.account(Retail.pos('rubrova-ci-refund'), Retail.cashPaymentMethod())),
        cardAccountBalance = Invoicing.balance(Retail.account(Retail.pos('rubrova-ci-refund'), Retail.paymentMethod('card')));

} @@api;

// Cancelar los dos egresos de la nota ya cancelada libera el cupo contable.
// Se reutilizan los documentos y estados nativos de MyCompany; no se borran pagos.
rubrovaTestCumulativeRefundReleaseApi () {
    FOR Retail.paymentMethod(rubrovaCIMixedFirstRefundBill(), Invoicing.OutgoingPayment p) DO
        Invoicing.cancel(p);

    NEWSESSION {
        NEW b = Invoicing.Bill {
            rubrovaCreateCIMixedReturn(b, rubrovaCIMixedInvoice(), 0.4, 200, 300);
            APPLY SERIALIZABLE;
            IF canceled() THEN RETURN;
        }
    }

    EXPORT JSON FROM
        originalBillActive = Invoicing.active(rubrovaCIMixedFirstRefundBill()),
        originalBillCanceled = Invoicing.canceled(rubrovaCIMixedFirstRefundBill()),
        originalBillReady = Invoicing.ready(rubrovaCIMixedFirstRefundBill()),
        originalBillActivityState = CASE WHEN Invoicing.active(rubrovaCIMixedFirstRefundBill()) THEN 'active' ELSE 'inactive',
        originalBillOutgoingActiveCount = (GROUP SUM 1
            IF Retail.paymentMethod(rubrovaCIMixedFirstRefundBill(), Invoicing.OutgoingPayment p)
               AND Invoicing.active(p)),
        activeReturnCount = rubrovaCIMixedActiveReturnCount(),
        activeReturnAmount = rubrovaCIMixedActiveReturnAmount(),
        returnedQuantity = rubrovaCIMixedReturnedQuantity(),
        activeCashRefundCount = rubrovaCIMixedActivePaymentCount(Retail.cashPaymentMethod()),
        activeCashRefundAmount = rubrovaCIMixedActivePaymentAmount(Retail.cashPaymentMethod()),
        activeCardRefundCount = rubrovaCIMixedActivePaymentCount(Retail.paymentMethod('card')),
        activeCardRefundAmount = rubrovaCIMixedActivePaymentAmount(Retail.paymentMethod('card')),
        onHand = Inventory.onHand(rubrovaCITestLocation(), rubrovaCITestProduct()),
        cashAccountBalance = Invoicing.balance(Retail.account(Retail.pos('rubrova-ci-refund'), Retail.cashPaymentMethod())),
        cardAccountBalance = Invoicing.balance(Retail.account(Retail.pos('rubrova-ci-refund'), Retail.paymentMethod('card')));

} @@api;

